# Laf Backend 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# ⚠️ 警告：.env.local 包含敏感信息，绝不能提交到版本控制！

# ==================== Sealos/Laf 配置 ====================
SEALOS_APP_ID=your_app_id
SEALOS_API_URL=https://sealaf-api.bja.sealos.run
SEALOS_PAT=your_sealos_pat_token

# ==================== 微信小程序配置 ====================
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# ==================== JWT 配置 ====================
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# ==================== AI 服务配置 ====================
# 智谱AI（用于拍照搜题、AI对话等）
ZHIPU_API_KEY=your_zhipu_api_key

# OpenAI（可选，作为备用）
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== CloudConvert 配置 ====================
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key

# ==================== 腾讯云配置 ====================
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_APPID=your_tencent_appid
TENCENT_COS_BUCKET=your_cos_bucket_name
TENCENT_COS_REGION=ap-beijing

# ==================== 搜索 API 配置 ====================
SERPAPI_KEY=your_serpapi_key
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# ==================== GitHub 配置 ====================
GITHUB_TOKEN=your_github_token

# ==================== 邮件服务配置 ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@example.com

# ==================== 速率限制配置 ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== 缓存配置 ====================
CACHE_ENABLED=true
CACHE_TTL=3600

# ==================== 运行环境配置 ====================
NODE_ENV=development
LOG_LEVEL=info

# ==================== 数据库配置 ====================
# MongoDB 连接字符串（Laf 自动提供，通常不需要手动配置）
# MONGODB_URI=mongodb://localhost:27017/exam_master

# ==================== 安全配置 ====================
# 允许的域名（CORS）
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# API 密钥（用于服务间调用）
INTERNAL_API_KEY=your_internal_api_key

# 审计模式（设为 true 时禁用 AI 功能）
AUDIT_MODE=false

# ✅ P007: 以下为之前遗漏的环境变量

# ==================== QQ 登录配置 ====================
QQ_APPID=your_qq_appid
QQ_SECRET=your_qq_secret
QQ_REDIRECT_URI=https://your-domain.com/pages/login/qq-callback

# ==================== 密码加密配置 ====================
PASSWORD_SALT=your_password_salt_random_string

# ==================== 管理员/清理配置 ====================
ADMIN_SECRET=your_admin_secret_key
CLEANUP_SECRET=your_cleanup_secret_key

# ==================== SiliconFlow AI 配置（多 Key 轮询） ====================
SILICONFLOW_API_KEY_1=your_siliconflow_key_1
SILICONFLOW_API_KEY_2=your_siliconflow_key_2
SILICONFLOW_API_KEY_3=your_siliconflow_key_3
