# ============================================
# Exam-Master 后端环境变量配置示例
# ✅ B017: 环境变量文档化（完整版）
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填入真实的配置值
# 3. 确保 .env 文件已加入 .gitignore
# ============================================

# ---------- 运行环境 ----------
# 可选值: development, production
NODE_ENV=development

# 日志级别: info, warn, error
LOG_LEVEL=info

# ---------- 微信小程序 ----------
# 微信小程序 AppID（从微信公众平台获取）
WX_APPID=your_wx_appid_here
# 微信小程序 AppSecret（从微信公众平台获取）
WX_SECRET=your_wx_secret_here

# ---------- 微信公众号（H5 OAuth 登录） ----------
# 微信公众号 AppID
WX_GZH_APPID=your_wx_gzh_appid_here
# 微信公众号 AppSecret
WX_GZH_SECRET=your_wx_gzh_secret_here

# ---------- QQ 登录 ----------
# QQ 互联 AppID
QQ_APPID=your_qq_appid_here
# QQ 互联 AppSecret
QQ_SECRET=your_qq_secret_here
# QQ OAuth 回调地址
QQ_REDIRECT_URI=https://your-domain.com/qq-callback

# ---------- JWT 认证 ----------
# JWT 签名密钥（建议使用 64 位以上随机字符串）
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_at_least_64_chars

# ---------- 密码安全 ----------
# 密码哈希盐值（建议使用 32 位以上随机字符串）
PASSWORD_SALT=your_password_salt_here

# ---------- AI Provider 号池（仅后端/云函数使用，严禁写入前端） ----------
# 路由默认使用 auto：只加载已配置 key 的免费/免费额度 provider，并按优先级自动降级。
AI_PREFERRED_PROVIDER=auto
# 手动摘除无余额、过期或临时不可用 provider/key；支持 provider 名称、entry id、key 环境变量名。
# 示例: AI_PROVIDER_DISABLED_LIST=openrouter,SILICONFLOW_DS_KEY_3
AI_PROVIDER_DISABLED_LIST=
AI_PROVIDER_DISABLED_KEYS=
# 默认不让付费 provider 进入自动降级链；需要付费兜底时显式打开。
AI_PROVIDER_ALLOW_PAID_FALLBACKS=false

# 主力：iFlow / 心流 OpenAI 兼容入口（用户重置后只需填新 key）
IFLOW_API_KEY=your_iflow_api_key_here
IFLOW_BASE_URL=https://apis.iflow.cn/v1/chat/completions
IFLOW_MODEL=TBStars2-200B-A13B

# 免费/免费额度 LLM 池
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://exam-master.local
OPENROUTER_APP_NAME=Exam-Master
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=qwen-3-32b
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
GITHUB_MODELS_TOKEN=your_github_models_token_here
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
GPT_API_FREE_KEY=your_gpt_api_free_key_here
GPT_API_FREE_MODEL=gpt-3.5-turbo
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
VERCEL_AI_GATEWAY_MODEL=openai/gpt-4o-mini

# SiliconFlow DeepSeek 专用余额 key 池（10条轮转；禁止 Pro/ 前缀模型）
SILICONFLOW_DS_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_DS_KEY_1=your_siliconflow_ds_key_1_here
SILICONFLOW_DS_KEY_2=your_siliconflow_ds_key_2_here
SILICONFLOW_DS_KEY_3=your_siliconflow_ds_key_3_here
SILICONFLOW_DS_KEY_4=your_siliconflow_ds_key_4_here
SILICONFLOW_DS_KEY_5=your_siliconflow_ds_key_5_here
SILICONFLOW_DS_KEY_6=your_siliconflow_ds_key_6_here
SILICONFLOW_DS_KEY_7=your_siliconflow_ds_key_7_here
SILICONFLOW_DS_KEY_8=your_siliconflow_ds_key_8_here
SILICONFLOW_DS_KEY_9=your_siliconflow_ds_key_9_here
SILICONFLOW_DS_KEY_10=your_siliconflow_ds_key_10_here

# 官方/付费兜底（默认不进入自动池，除非 AI_PROVIDER_ALLOW_PAID_FALLBACKS=true）
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OFFICIAL_API_KEY=your_siliconflow_official_api_key_here
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_MODEL=doubao-1-5-lite-32k-250115
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-flash

# ---------- AI 多Agent课堂配置 ----------
# 各Agent角色默认使用的模型
DEFAULT_TEACHER_MODEL=glm-4-plus
DEFAULT_STUDENT_MODEL=glm-4-flash
DEFAULT_EXAMINER_MODEL=glm-4.5-air
# LangSmith 追踪（可选，当前未集成）
# LANGCHAIN_API_KEY=

# ---------- AI 路由配置 ----------
# 是否启用自动切换（当某个 provider 不可用时自动切换）
AI_ROUTER_ENABLE_AUTO_SWITCH=true
# 是否启用负载均衡
AI_ROUTER_ENABLE_LOAD_BALANCE=true
# 健康检查间隔（毫秒）
AI_ROUTER_HEALTH_CHECK_INTERVAL=300000
# 最大重试次数
AI_ROUTER_MAX_RETRIES=2
# AI 请求超时（毫秒）
AI_ROUTER_TIMEOUT=30000
# 是否优先使用免费模型
AI_ROUTER_PREFER_FREE_MODELS=true
# 每日预算限制（元）
AI_ROUTER_DAILY_BUDGET_LIMIT=10
# 各 Provider 流量比例
AI_ROUTER_SILICONFLOW_RATIO=0.6
AI_ROUTER_ZHIPU_RATIO=0.3
AI_ROUTER_TENCENT_RATIO=0.1

# ---------- 腾讯云服务 ----------
# 腾讯云 SecretId（用于证件照、COS 等服务）
TENCENT_SECRET_ID=your_tencent_secret_id_here
# 腾讯云 SecretKey
TENCENT_SECRET_KEY=your_tencent_secret_key_here
# 腾讯云 AppID
TENCENT_APPID=your_tencent_appid_here
# COS 存储桶名称
TENCENT_COS_BUCKET=your-bucket-name
# COS 区域
TENCENT_COS_REGION=ap-beijing

# ---------- 文档转换 ----------
# CloudConvert API Key（用于 PDF/Word 转换）
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here

# ---------- 搜索服务 ----------
# SerpApi Key（用于搜索功能）
SERPAPI_KEY=your_serpapi_key_here
# Brave Search API Key
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ---------- 邮件服务（SMTP） ----------
# SMTP 服务器地址
SMTP_HOST=smtp.example.com
# SMTP 端口
SMTP_PORT=465
# SMTP 用户名
SMTP_USER=your_email@example.com
# SMTP 密码/授权码
SMTP_PASS=your_smtp_password_here
# 发件人地址
SMTP_FROM=noreply@exammaster.app

# ---------- GitHub ----------
# GitHub Personal Access Token（用于版本检查等）
GITHUB_TOKEN=your_github_token_here

# ---------- 管理员 ----------
# 管理员操作密钥（用于数据清理等敏感操作）
ADMIN_SECRET=your_admin_secret_here
# 数据清理授权密钥
CLEANUP_SECRET=your_cleanup_secret_here
# 账户彻底清除授权密钥（account-purge）
ADMIN_PURGE_TOKEN=your_admin_purge_token_here

# ---------- 安全配置 ----------
# CORS 允许的源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
# 服务间通信 API Key
INTERNAL_API_KEY=your_internal_api_key_here
# 审核模式（微信审核期间开启）
AUDIT_MODE=false

# ---------- 速率限制 ----------
# 速率限制窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000
# 窗口内最大请求数
RATE_LIMIT_MAX_REQUESTS=100

# ---------- 缓存配置 ----------
# 是否启用缓存
CACHE_ENABLED=true
# 缓存过期时间（秒）
CACHE_TTL=300

# ---------- 请求安全 ----------
# 请求签名盐值（后端专用；不要使用 VITE_ 前缀放入客户端包；至少 24 字符）
# 生成方式: openssl rand -hex 32
REQUEST_SIGN_SALT=your_request_sign_salt_here_at_least_24_chars

# ---------- 排行榜缓存 ----------
# 是否启用排行榜内存缓存（true/false）
ENABLE_RANK_CACHE=true

# ---------- 邮件重试 ----------
# SMTP 发送失败最大重试次数
SMTP_RETRY_TIMES=3
# SMTP 重试间隔（毫秒）
SMTP_RETRY_DELAY_MS=1000

# ---------- 服务器通信密钥（已弃用，保留兼容） ----------
# 服务间共享密钥（如无使用可删除）
# SERVER_SECRET=your_server_secret_here

# ---------- 脚本与测试 ----------
# 后端压测/联调 API 地址（scripts/test/load-test.ts 使用）
LAF_API_URL=https://your-sealos-domain.sealosbja.site
