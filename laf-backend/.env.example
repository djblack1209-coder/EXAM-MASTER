# 服务端配置模板：复制/注入前按实际部署核对；不是自动读取的生产配置。
# 密钥禁止放入 VITE_ 变量、源码、普通备份或日志。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/exam-master-development
DB_NAME=exam-master-development
STORAGE_DIR=./storage
LOG_LEVEL=info
# 生产必须显式配置，不能继承开发或退休来源。
ALLOWED_ORIGINS=http://localhost:5173

# 鉴权和请求签名：填独立随机值，空值不会赋予访问权。
JWT_SECRET=
PASSWORD_SALT=
REQUEST_SIGN_SALT=
AUDIT_MODE=false
ADMIN_SECRET=
ADMIN_PURGE_TOKEN=
CLEANUP_SECRET=
INTERNAL_API_KEY=
WORKER_AUTH_TOKEN=

# 仅实际使用的登录/内容审核渠道；未配置则对应能力不可用。
WX_APPID=
WX_SECRET=
WX_GZH_APPID=
WX_GZH_SECRET=
QQ_APPID=
QQ_SECRET=
QQ_REDIRECT_URI=

# 真实供应商/模型/能力/价格版本/预算未经核验，不开启平台调用。
# MODELS 为 ModelConfig[]，字段合同见 learning-provider.ts 与 proxy-ai.ts。
# 各条 keyEnv 指向独立运行环境密钥；没有默认模型或自动付费兜底。
LEARNING_PLATFORM_CALLS_ENABLED=false
LEARNING_PLATFORM_MODELS=[]
LEARNING_ALLOWED_ORIGINS=
# BYOK服务端保险库加密密钥，与JWT分开；普通备份不包含模型保险库。
LEARNING_VAULT_KEY=
# 自带API账户调用次数安全上限（1–500；默认500，计入失败/预留，非周权益）。
LEARNING_BYOK_CALL_LIMIT=500
# 私人模型结果恢复缓存（资源配置，非销售权益），按访问清理；空值使用24小时/32条/1MiB。
LEARNING_MODEL_RESULT_CACHE={"ttlMs":86400000,"maxEntries":32,"maxBytes":1048576,"maxResultBytes":131072}

# 仅签名开发沙箱，非正式销售权益；默认关闭，无真实支付渠道。
LEARNING_PAYMENT_SANDBOX_ENABLED=false
LEARNING_PAYMENT_SANDBOX_POLICY={}
LEARNING_PAYMENT_SANDBOX_SECRET=

# SMTP真实发送另需授权，未配置时不能假报发送成功。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_RETRY_TIMES=3
SMTP_RETRY_DELAY_MS=1000
# 旧health-check仅看此配置，不代表模型连接或预算验收。
ZHIPU_API_KEY=
