{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "..",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@lafjs/cloud": ["./cloud-shim.ts"],
      "nodemailer": ["./node_modules/nodemailer/dist/esm/nodemailer.js"]
    },
    "baseUrl": ".",
    "allowJs": true,
    "noEmitOnError": true
  },
  "include": ["./**/*.ts", "../functions/**/*.ts", "../functions/_shared/learning-domain.js"],
  "exclude": ["../node_modules", "../dist"]
}
