{
  "name": "exam-master",
  "version": "2.2.0",
  "description": "考研备考小程序 - AI助力，一战成硕",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-qq": "uni -p mp-qq",
    "dev:h5": "uni -p h5",
    "build": "uni build -p h5",
    "build:app": "uni build -p app",
    "dev:app": "uni -p app",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/build/inject-mp-weixin-privacy.mjs",
    "audit:mp-main-usage": "npm run build:mp-weixin && node scripts/build/check-mp-main-package-usage.mjs",
    "audit:ui-quality": "node scripts/build/ui-quality-gate.js",
    "audit:deep-scan": "node scripts/build/deep-scan.js",
    "audit:secrets:tracked": "bash scripts/build/audit-tracked-secrets.sh",
    "audit:laf:function-sources": "node scripts/build/audit-laf-function-sources.mjs",
    "audit:subpkg-sync": "node scripts/build/check-subpkg-duplicates.mjs",
    "audit:question-bank:report": "node scripts/build/question-bank-release-gate.mjs",
    "audit:question-bank:release": "node scripts/build/question-bank-release-gate.mjs --fail-on-blockers",
    "audit:release:external:report": "node scripts/build/release-external-gate.mjs",
    "audit:release:external": "node scripts/build/release-external-gate.mjs --fail-on-blockers",
    "audit:release:backlog": "node scripts/build/release-blocker-backlog.mjs",
    "audit:release:backlog:release": "node scripts/build/release-blocker-backlog.mjs --fail-on-blockers",
    "audit:wechat:artifacts": "node scripts/build/verify-wechat-artifacts.mjs",
    "smoke:wechat:devtools": "node scripts/build/wechat-devtools-release-smoke.mjs --fail-on-blockers",
    "smoke:jwt": "node scripts/build/create-smoke-jwt.mjs",
    "test:cloud:smoke": "node scripts/build/live-cloud-smoke.mjs",
    "test:cloud:smoke:release": "node scripts/build/live-cloud-smoke.mjs --fail-on-skipped",
    "build:mp-qq": "uni build -p mp-qq",
    "build:h5": "uni build -p h5 && node scripts/build/copy-cdn-to-h5.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src/",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,json}\"",
    "assets:png:dry-run": "node scripts/assets/generate-png-assets.mjs --dry-run",
    "assets:png:generate": "node scripts/assets/generate-png-assets.mjs",
    "assets:png:validate": "node scripts/assets/generate-png-assets.mjs --validate-only",
    "baidu:manifest:self-test": "python3 scripts/baidu/source_manifest.py --self-test",
    "baidu:manifest:quality:self-test": "python3 scripts/baidu/manifest_quality.py --self-test",
    "baidu:manifest:quality": "python3 scripts/baidu/manifest_quality.py",
    "baidu:netdisk:candidate-coverage": "python3 scripts/baidu/public_course_candidate_coverage.py",
    "baidu:cleaning:queue:self-test": "python3 scripts/baidu/cleaning_queue.py --self-test",
    "baidu:cleaning:queue": "python3 scripts/baidu/cleaning_queue.py",
    "baidu:cleaning:run:self-test": "python3 scripts/baidu/run_cleaning_queue.py --self-test",
    "baidu:cleaning:run:dry": "python3 scripts/baidu/run_cleaning_queue.py --dry-run --limit 3",
    "baidu:cleaning:run": "python3 scripts/baidu/run_cleaning_queue.py --limit 1",
    "baidu:flashcards:repair:answers": "python3 scripts/baidu/answer_evidence_repair.py",
    "baidu:flashcards:quality": "python3 scripts/baidu/flashcard_quality.py",
    "baidu:flashcards:quality:release": "python3 scripts/baidu/flashcard_quality.py --fail-on-blockers",
    "baidu:sources:verified": "python3 scripts/baidu/verified_source_registry.py --registry data/verified-source-registry.json --output data/verified-source-export.json",
    "baidu:sources:merge": "python3 scripts/baidu/source_manifest.py --input data/verified-source-export.json --source-channel verified_registry && python3 scripts/baidu/manifest_quality.py --manifest data/source-manifest.json --output data/source-manifest-quality.json",
    "baidu:sync:dry-run": "python3 scripts/baidu/incremental_sync.py --dry-run",
    "baidu:sync": "python3 scripts/baidu/incremental_sync.py --download",
    "baidu:sync:netdisk:dry": "python3 scripts/baidu/incremental_sync.py --dry-run --scan-dir \"/EXAM-MASTER/考研历年真题/01.考研政治\" --scan-dir \"/EXAM-MASTER/考研历年真题/02.考研英语\" --scan-dir \"/EXAM-MASTER/考研历年真题/03.考研数学\"",
    "baidu:sync:netdisk:queue": "python3 scripts/baidu/incremental_sync.py --scan-dir \"/EXAM-MASTER/考研历年真题/01.考研政治\" --scan-dir \"/EXAM-MASTER/考研历年真题/02.考研英语\" --scan-dir \"/EXAM-MASTER/考研历年真题/03.考研数学\" && npm run baidu:manifest:quality && npm run baidu:netdisk:candidate-coverage && npm run baidu:cleaning:queue",
    "baidu:group:registry:check": "python3 scripts/baidu/group_sync.py --validate-registry",
    "baidu:group:sync:dry": "python3 scripts/baidu/group_sync.py --mode=sharelink --dry-run",
    "baidu:group:sync": "python3 scripts/baidu/group_sync.py --mode=sharelink",
    "baidu:group-file:index:self-test": "python3 scripts/baidu/group_file_index.py --self-test",
    "baidu:group-file:index:dry": "python3 scripts/baidu/group_file_index.py --dry-run",
    "baidu:group-file:index": "python3 scripts/baidu/group_file_index.py",
    "release:gate:report": "npm run build:h5 && npm run build:mp-weixin && npm run deps:audit:prod && npm run audit:question-bank:report && npm run baidu:flashcards:quality && npm run audit:release:external:report && npm run audit:release:backlog && npm run audit:wechat:artifacts",
    "release:gate": "npm run build:h5 && npm run build:mp-weixin && npm run deps:audit:prod && npm run audit:question-bank:release && npm run baidu:flashcards:quality:release && npm run audit:release:external && npm run audit:release:backlog:release && npm run audit:wechat:artifacts && npm run test:cloud:smoke:release",
    "deps:check": "npm outdated",
    "deps:audit": "npm audit --registry=https://registry.npmjs.org || true",
    "deps:audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org || true",
    "release:patch": "npm version patch --no-git-tag-version && git add package.json && git commit -m \"chore: bump version patch\"",
    "release:minor": "npm version minor --no-git-tag-version && git add package.json && git commit -m \"chore: bump version minor\"",
    "release:major": "npm version major --no-git-tag-version && git add package.json && git commit -m \"chore: bump version major\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app-plus": "^3.0.0-alpha-5000220260306001",
    "@dcloudio/uni-app-vite": "^3.0.0-alpha-5000220260306001",
    "@dcloudio/uni-components": "^3.0.0-alpha-5000220260306001",
    "pinia": "2.1.7",
    "ts-fsrs": "^5.3.1",
    "vue": "3.4.21",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.1",
    "@csstools/postcss-color-mix-function": "^3.0.12",
    "@dcloudio/types": "^3.3.2",
    "@dcloudio/uni-app": "^3.0.0-alpha-5000220260306001",
    "@dcloudio/uni-cli-shared": "^3.0.0-alpha-5000220260306001",
    "@dcloudio/uni-h5": "^3.0.0-alpha-5000220260306001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-5000220260306001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-alpha-5000220260306001",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "commitlint": "^20.4.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "miniprogram-automator": "^0.12.1",
    "prettier": "^3.5.3",
    "sass": "^1.97.3",
    "terser": "^5.27.0",
    "vite": "^6.4.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0",
    "yaml": "^2.8.3"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "微信小程序",
    "考研",
    "AI学习"
  ],
  "author": "Exam-Master Team",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "browserslist": [
    "Android >= 5",
    "iOS >= 10",
    "Chrome >= 53",
    "Safari >= 10",
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.2"
  },
  "overrides": {
    "@intlify/core-base": "9.14.5",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/shared": "9.14.5",
    "@intlify/vue-devtools": "9.14.5",
    "esbuild": "0.25.12",
    "postcss": "8.5.12"
  }
}
