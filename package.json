{
  "name": "yozi-ai",
  "version": "2.2.0",
  "description": "以对话为主要入口的自适应学习与复习平台",
  "type": "module",
  "scripts": {
    "dev": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-qq": "uni -p mp-qq",
    "dev:h5": "uni -p h5",
    "dev:local-model": "node scripts/build/local-model-connector.mjs",
    "build": "uni build -p h5",
    "build:app": "uni build -p app",
    "dev:app": "uni -p app",
    "build:mp-weixin": "node scripts/build/generate-compressed-bank-modules.mjs && uni build -p mp-weixin && node scripts/build/inject-mp-weixin-privacy.mjs",
    "audit:mp-main-usage": "npm run build:mp-weixin && node scripts/build/check-mp-main-package-usage.mjs",
    "audit:ui-quality": "node scripts/build/ui-quality-gate.js",
    "audit:deep-scan": "node scripts/build/deep-scan.js",
    "audit:secrets:tracked": "bash scripts/build/audit-tracked-secrets.sh",
    "audit:laf:function-sources": "node scripts/build/audit-laf-function-sources.mjs",
    "audit:subpkg-sync": "node scripts/build/check-subpkg-duplicates.mjs",
    "audit:question-bank:report": "node scripts/build/question-bank-release-gate.mjs",
    "audit:question-bank:release": "node scripts/build/question-bank-release-gate.mjs --fail-on-blockers",
    "audit:release:external:report": "node scripts/build/release-external-gate.mjs",
    "audit:release:external": "node scripts/build/release-external-gate.mjs --fail-on-blockers",
    "audit:release:backlog": "node scripts/build/release-blocker-backlog.mjs",
    "audit:release:backlog:release": "node scripts/build/release-blocker-backlog.mjs --fail-on-blockers",
    "audit:wechat:artifacts": "node scripts/build/verify-wechat-artifacts.mjs",
    "smoke:wechat:devtools": "node scripts/build/wechat-devtools-release-smoke.mjs --fail-on-blockers",
    "audit:app:artifacts": "node scripts/build/verify-app-artifacts.mjs",
    "smoke:jwt": "node scripts/build/create-smoke-jwt.mjs",
    "test:cloud:smoke": "node scripts/build/live-cloud-smoke.mjs",
    "test:cloud:smoke:release": "node scripts/build/live-cloud-smoke.mjs --fail-on-skipped",
    "build:mp-qq": "uni build -p mp-qq",
    "build:h5": "uni build -p h5 && node scripts/build/copy-cdn-to-h5.mjs",
    "audit:mobile:h5-viewports": "node scripts/build/mobile-viewport-smoke.mjs",
    "audit:mobile:inventory": "node scripts/build/mobile-module-inventory.mjs --output data/mobile-module-inventory.json",
    "audit:mobile:baseline": "npm run build:app && npm run audit:app:artifacts && npm run audit:mobile:inventory && npm run build:h5 && npm run audit:mobile:h5-viewports",
    "test": "vitest run",
    "test:baidu:pipeline": ".venv-baidu/bin/python -m unittest tests.unit.test_private_material_parser tests.unit.test_material_upload_recovery tests.unit.test_material_upload_maintenance tests.unit.test_english_answer_key_verify tests.unit.test_english_passage_repair tests.unit.test_english_writing_prompt_verify tests.unit.test_flashcard_quality",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src/",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss,json}\" \"scripts/**/*.{js,mjs,cjs}\" \"tests/**/*.{js,ts}\" \"laf-backend/{functions,standalone,utils,triggers,types}/**/*.{js,mjs,ts}\" \"*.{js,json}\" \".github/**/*.{yml,yaml}\" \"docs/**/*.md\" \"README.md\" \"AGENTS.md\" \"deploy/**/*.{js,cjs,json,yml,yaml}\" \"laf-backend/{package,tsconfig}.json\" \"laf-backend/standalone/*.json\" \"laf-backend/functions/*.yaml\" \"public/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss,json}\" \"scripts/**/*.{js,mjs,cjs}\" \"tests/**/*.{js,ts}\" \"laf-backend/{functions,standalone,utils,triggers,types}/**/*.{js,mjs,ts}\" \"*.{js,json}\" \".github/**/*.{yml,yaml}\" \"docs/**/*.md\" \"README.md\" \"AGENTS.md\" \"deploy/**/*.{js,cjs,json,yml,yaml}\" \"laf-backend/{package,tsconfig}.json\" \"laf-backend/standalone/*.json\" \"laf-backend/functions/*.yaml\" \"public/*.js\"",
    "assets:png:dry-run": "node scripts/assets/generate-png-assets.mjs --dry-run",
    "assets:png:generate": "node scripts/assets/generate-png-assets.mjs",
    "assets:png:validate": "node scripts/assets/generate-png-assets.mjs --validate-only",
    "baidu:manifest:self-test": "python3 scripts/baidu/source_manifest.py --self-test",
    "baidu:manifest:quality:self-test": "python3 scripts/baidu/manifest_quality.py --self-test",
    "baidu:manifest:quality": "python3 scripts/baidu/manifest_quality.py",
    "baidu:netdisk:candidate-coverage": "python3 scripts/baidu/public_course_candidate_coverage.py",
    "baidu:cleaning:queue:self-test": "python3 scripts/baidu/cleaning_queue.py --self-test",
    "baidu:cleaning:queue": "python3 scripts/baidu/cleaning_queue.py",
    "baidu:flashcards:repair:answers": "python3 scripts/baidu/answer_evidence_repair.py",
    "baidu:flashcards:quality:self-test": "python3 scripts/baidu/flashcard_quality.py --self-test",
    "baidu:flashcards:quality": "python3 scripts/baidu/flashcard_quality.py",
    "baidu:flashcards:quality:release": "python3 scripts/baidu/flashcard_quality.py --fail-on-blockers",
    "baidu:sources:verified": "python3 scripts/baidu/verified_source_registry.py --registry data/verified-source-registry.json --output data/verified-source-export.json",
    "baidu:sources:merge": "python3 scripts/baidu/source_manifest.py --input data/verified-source-export.json --source-channel verified_registry && python3 scripts/baidu/manifest_quality.py --manifest data/source-manifest.json --output data/source-manifest-quality.json",
    "baidu:sync:dry-run": "python3 scripts/baidu/incremental_sync.py --dry-run",
    "baidu:sync": "python3 scripts/baidu/incremental_sync.py --download",
    "baidu:sync:netdisk:dry": "python3 scripts/baidu/incremental_sync.py --dry-run --scan-dir \"/EXAM-MASTER/考研历年真题/01.考研政治\" --scan-dir \"/EXAM-MASTER/考研历年真题/02.考研英语\" --scan-dir \"/EXAM-MASTER/考研历年真题/03.考研数学\"",
    "baidu:sync:netdisk:queue": "python3 scripts/baidu/incremental_sync.py --scan-dir \"/EXAM-MASTER/考研历年真题/01.考研政治\" --scan-dir \"/EXAM-MASTER/考研历年真题/02.考研英语\" --scan-dir \"/EXAM-MASTER/考研历年真题/03.考研数学\" && npm run baidu:manifest:quality && npm run baidu:netdisk:candidate-coverage && npm run baidu:cleaning:queue",
    "baidu:group:registry:check": "python3 scripts/baidu/group_sync.py --validate-registry",
    "baidu:group:sync:dry": "python3 scripts/baidu/group_sync.py --mode=sharelink --dry-run",
    "baidu:group:sync": "python3 scripts/baidu/group_sync.py --mode=sharelink",
    "baidu:group-file:index:self-test": "python3 scripts/baidu/group_file_index.py --self-test",
    "baidu:group-file:index:dry": "python3 scripts/baidu/group_file_index.py --dry-run",
    "baidu:group-file:index": "python3 scripts/baidu/group_file_index.py",
    "release:gate:report": "npm run build:h5 && npm run build:mp-weixin && npm run audit:public-build && npm run deps:audit:prod && npm run audit:question-bank:report && npm run baidu:flashcards:quality && npm run audit:release:external:report && npm run audit:release:backlog && npm run audit:wechat:artifacts",
    "release:gate": "npm run build:h5 && npm run build:mp-weixin && npm run audit:public-build && npm run deps:audit:prod && npm run audit:question-bank:release && npm run baidu:flashcards:quality:release && npm run audit:release:external && npm run audit:release:backlog:release && npm run audit:wechat:artifacts && npm run test:cloud:smoke:release",
    "deps:check": "npm outdated",
    "deps:audit": "npm audit --registry=https://registry.npmjs.org",
    "deps:audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "prepare": "husky",
    "audit:repository": "node scripts/build/repository-health.mjs --strict",
    "security:signing-salt": "node scripts/build/create-request-signing-salt.mjs",
    "lint:tooling": "eslint --max-warnings=0 scripts/ tests/ *.config.js",
    "typecheck:backend": "npm run typecheck --prefix laf-backend/standalone",
    "build:backend": "npm run build --prefix laf-backend/standalone",
    "lint:python": "ruff check scripts tests && ruff format --check scripts tests",
    "audit:backend:runtime": "node scripts/build/audit-backend-runtime.mjs",
    "test:backend:http": "node scripts/build/verify-backend-http.mjs",
    "test:app:connector": "node scripts/build/verify-app-connector.mjs",
    "test:app:material": "node scripts/build/verify-app-material.mjs",
    "build:apple:vision": "node scripts/build/build-apple-vision.mjs --build-only",
    "test:apple:vision": "node scripts/build/verify-apple-vision.mjs",
    "build:app:connector": "node scripts/build/build-app-connector.mjs --build-only",
    "dev:desktop": "node scripts/build/desktop.mjs dev",
    "build:desktop": "node scripts/build/desktop.mjs build",
    "build:desktop:web": "node scripts/build/desktop.mjs web",
    "test:desktop:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "audit:public-build": "node scripts/build/ui-quality-gate.js --public-build"
  },
  "dependencies": {
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-app-vite": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@tauri-apps/api": "2.12.3",
    "pako": "^1.0.11",
    "pinia": "2.1.7",
    "ts-fsrs": "5.4.2",
    "vue": "3.5.43",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.1",
    "@csstools/postcss-color-mix-function": "^3.0.12",
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030120260930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@tauri-apps/cli": "2.12.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.5.1",
    "adm-zip": "^0.6.1",
    "commitlint": "^20.4.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.11.1",
    "file-type": "file:./scripts/compat/file-type",
    "file-type-modern": "npm:file-type@21.3.4",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "miniprogram-automator": "^0.12.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "terser": "^5.51.2",
    "vite": "^6.4.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.1",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "微信小程序",
    "考研",
    "AI学习"
  ],
  "author": "Yozi AI Team",
  "license": "UNLICENSED",
  "packageManager": "npm@10.8.2",
  "browserslist": [
    "Android >= 5",
    "iOS >= 10",
    "Chrome >= 53",
    "Safari >= 10",
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.8.2"
  },
  "overrides": {
    "@intlify/core-base": "9.14.5",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/shared": "9.14.5",
    "@intlify/vue-devtools": "9.14.5",
    "esbuild": "0.25.12",
    "postcss": "$postcss",
    "miniprogram-automator": {
      "minimist": "0.2.4"
    },
    "adm-zip": "$adm-zip",
    "@babel/core@^7.0.0": "7.29.7",
    "express@^4.0.0": "4.22.3",
    "body-parser@^1.0.0": "1.20.8",
    "qs@^6.0.0": "6.16.0",
    "ws@^6.0.0": "6.2.6",
    "ws@^8.0.0": "8.22.0",
    "jimp": "0.22.12",
    "serialize-javascript": "7.0.5",
    "@humanfs/node": "0.16.8",
    "file-type": "$file-type",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "vue": "$vue",
    "@vue/shared": "3.5.43",
    "@vue/reactivity": "3.5.43",
    "@vue/runtime-core": "3.5.43",
    "@vue/runtime-dom": "3.5.43",
    "@vue/compiler-core": "3.5.43",
    "@vue/compiler-dom": "3.5.43",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/compiler-ssr": "3.5.43",
    "@vue/server-renderer": "3.5.43"
  },
  "private": true
}
