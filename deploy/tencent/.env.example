# 腾讯云部署环境变量模板
# 完整变量说明请参考 laf-backend/.env.example
# ============================================
# 复制为 .env 并填入真实值
# ============================================

# ---------- MongoDB ----------
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MONGO_APP_PASSWORD=CHANGE_ME_strong_app_password

# ---------- 镜像版本 ----------
VERSION=latest

# ---------- JWT/Auth ----------
JWT_SECRET=your_jwt_secret_here
PASSWORD_SALT=your_password_salt_here

# ---------- 微信小程序 ----------
WX_APPID=your_wx_appid_here
WX_SECRET=your_wx_secret_here

# ---------- QQ 登录 ----------
QQ_APPID=your_qq_appid_here
QQ_SECRET=your_qq_secret_here

# ---------- AI Provider 号池（后端专用） ----------
AI_PREFERRED_PROVIDER=auto
AI_PROVIDER_DISABLED_LIST=
AI_PROVIDER_DISABLED_KEYS=
AI_PROVIDER_ALLOW_PAID_FALLBACKS=false
IFLOW_API_KEY=your_iflow_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GITHUB_MODELS_TOKEN=your_github_models_token_here
HF_TOKEN=your_huggingface_token_here
GPT_API_FREE_KEY=your_gpt_api_free_key_here
SILICONFLOW_DS_KEY_1=your_siliconflow_ds_key_1_here
SILICONFLOW_DS_KEY_2=your_siliconflow_ds_key_2_here
SILICONFLOW_DS_KEY_3=your_siliconflow_ds_key_3_here
SILICONFLOW_OFFICIAL_API_KEY=your_siliconflow_official_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here

# ---------- 管理员 ----------
ADMIN_SECRET=your_admin_secret_here
CLEANUP_SECRET=your_cleanup_secret_here

# ---------- 请求签名（后端专用，不要使用 VITE_ 前缀） ----------
REQUEST_SIGN_SALT=your_request_sign_salt_here

# ---------- 邮件服务（SMTP） ----------
SMTP_HOST=your_smtp_host_here
SMTP_PORT=465
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_pass_here
