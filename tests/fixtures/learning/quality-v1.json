{
  "version": "learning-quality-1.1",
  "provenance": "项目自编固定算例，期望值人工独立计算；非模型生成答案、非公开真题。",
  "claims": "仅验证有限判分及安全降级机制，不能证明全学科效果或长期学习效果。",
  "cases": [
    {
      "id": "choice-correct",
      "category": "客观题",
      "validation": {
        "type": "choice",
        "answer": "B",
        "authority": "human_reviewed",
        "evidenceId": "fixture-manual-choice"
      },
      "answer": "我选B",
      "expectedStatus": "reliable",
      "expectedOutcome": "correct",
      "prompt": "2+2 的结果是多少？",
      "options": ["A.3", "B.4", "C.5"]
    },
    {
      "id": "choice-wrong",
      "category": "客观题",
      "validation": {
        "type": "choice",
        "answer": "AC",
        "authority": "human_reviewed",
        "evidenceId": "fixture-manual-multiple"
      },
      "answer": "A",
      "expectedStatus": "reliable",
      "expectedOutcome": "wrong",
      "prompt": "选择所有偶数。",
      "options": ["A.2", "B.3", "C.4"]
    },
    {
      "id": "equivalent-fraction",
      "category": "计算题",
      "validation": {
        "type": "number",
        "answer": "1/2",
        "authority": "executable",
        "evidenceId": "fixture-rational"
      },
      "answer": "0.5",
      "expectedStatus": "reliable",
      "expectedOutcome": "correct",
      "prompt": "将1/2写成等价小数。",
      "options": []
    },
    {
      "id": "unit-correct",
      "category": "单位",
      "validation": {
        "type": "number",
        "answer": "2",
        "unit": "m",
        "authority": "human_reviewed",
        "evidenceId": "fixture-unit"
      },
      "answer": "2m",
      "expectedStatus": "reliable",
      "expectedOutcome": "correct",
      "prompt": "一段长度为2米，用m表达。",
      "options": []
    },
    {
      "id": "unit-needs-conversion",
      "category": "单位",
      "validation": {
        "type": "number",
        "answer": "2",
        "unit": "m",
        "authority": "human_reviewed",
        "evidenceId": "fixture-unit"
      },
      "answer": "200cm",
      "expectedStatus": "reliable",
      "expectedOutcome": "correct",
      "prompt": "一段长度为2米，用等价单位表达。",
      "options": []
    },
    {
      "id": "subjective-rubric",
      "category": "主观题",
      "validation": {
        "type": "rubric",
