      "answer": "一个可讨论的论点和论据。",
      "expectedStatus": "pending",
      "expectedOutcome": null,
      "prompt": "用论点和论据说明一个观点。",
      "options": []
    },
    {
      "id": "multiple-roots",
      "category": "多解",
      "validation": {
        "type": "number_set",
        "answers": [-2, 2],
        "authority": "human_reviewed",
        "evidenceId": "fixture-roots"
      },
      "answer": "±2",
      "expectedStatus": "reliable",
      "expectedOutcome": "correct",
      "prompt": "解x的平方=4，给出全部实根。",
      "options": []
    },
    {
