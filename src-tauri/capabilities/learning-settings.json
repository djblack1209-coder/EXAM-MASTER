{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "learning-settings",
  "description": "设置窗口只可打开白名单工作区、修改外观和请求主窗口刷新提醒；不拥有通知调度或文件权限。",
  "windows": [
    "settings"
  ],
  "local": true,
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "allow-close-desktop-settings",
    "allow-open-desktop-workspace",
    "allow-set-desktop-appearance",
    "allow-request-settings-notification-refresh",
    "allow-learning-notification-permission",
    "allow-test-learning-notification",
    "allow-open-learning-notification-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
