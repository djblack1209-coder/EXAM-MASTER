{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yozi AI",
  "version": "2.2.0",
  "identifier": "cn.wangshiliang.wenli",
  "build": {
    "beforeBuildCommand": "npm run build:desktop:web",
    "beforeDevCommand": "npm run build:desktop:web",
    "frontendDist": "../dist/build/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Yozi AI",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#eae8fc",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https://d8j0ntlcm91z4.cloudfront.net; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:* http://[::1]:*; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": ["learning-desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "从一个问题开始，在对话中理解、练习和复习。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
