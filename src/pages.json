{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^OfflineIndicator$": "@/components/common/offline-indicator.vue",
      "^BaseIcon$": "@/components/base/base-icon/base-icon.vue"
    }
  },
  "pages": [
    {
      "path": "pages/splash/index",
      "style": {
        "navigationBarTitleText": "%pages.splash%",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "%pages.home%",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    },
    {
      "path": "pages/practice/index",
      "style": {
        "navigationBarTitleText": "%pages.practice%",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "%pages.profile%",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/practice-sub",
      "pages": [
        {
          "path": "do-quiz",
          "style": {
            "navigationBarTitleText": "%pages.quiz%",
