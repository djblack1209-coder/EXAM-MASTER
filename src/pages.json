            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "terms",
          "style": {
            "navigationBarTitleText": "%pages.terms%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/mistake",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "%pages.mistake%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/favorite",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "%pages.favorite%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/learning",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "%pages.learning%",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/plan",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "%pages.plan%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/study-detail",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "%pages.stats%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/practice/index": {
      "network": "all",
      "packages": ["pages/practice-sub"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "%pages.home%",
    "navigationBarBackgroundColor": "#F5F7FA",
    "backgroundColor": "#F5F7FA",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "uniIdRouter": {},
  "tabBar": {
    "custom": true,
    "color": "#65618A",
    "selectedColor": "#7352EC",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "%nav.home%",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/practice/index",
        "text": "%nav.practice%",
        "iconPath": "static/tabbar/practice.png",
        "selectedIconPath": "static/tabbar/practice-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "%nav.profile%",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  }
}
