{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^OfflineIndicator$": "@/components/common/offline-indicator.vue",
      "^BaseIcon$": "@/components/base/base-icon/base-icon.vue",
      "^[Ee]m3d-switch$": "@/components/base/em3d-switch/em3d-switch.vue"
    }
  },
  "pages": [
    {
      "path": "pages/splash/index",
      "style": {
        "navigationBarTitleText": "EXAM-MASTER",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    },
    {
      "path": "pages/practice/index",
      "style": {
        "navigationBarTitleText": "智能刷题",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationStyle": "custom",
        "navigationBarBackgroundColor": "#F5F7FA"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/practice-sub",
      "pages": [
        {
          "path": "do-quiz",
          "style": {
            "navigationBarTitleText": "刷题进行中",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "question-bank",
          "style": {
            "navigationBarTitleText": "考研题库",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "professional-index",
          "style": {
            "navigationBarTitleText": "专业课索引",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/login",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "onboarding",
          "style": {
            "navigationBarTitleText": "开始使用",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "wechat-callback",
          "style": {
            "navigationBarTitleText": "微信登录",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/settings",
      "pages": [
        {
          "path": "privacy",
          "style": {
            "navigationBarTitleText": "隐私政策",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "terms",
          "style": {
            "navigationBarTitleText": "用户协议",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/mistake",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "错题本",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/practice/index": {
      "network": "all",
      "packages": ["pages/practice-sub"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "EXAM-MASTER",
    "navigationBarBackgroundColor": "#F5F7FA",
    "backgroundColor": "#F5F7FA",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },

  "uniIdRouter": {},
  "tabBar": {
    "custom": true,
    "color": "#8E8E93",
    "selectedColor": "#34C759",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/practice/index",
        "text": "刷题",
        "iconPath": "static/tabbar/practice.png",
        "selectedIconPath": "static/tabbar/practice-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  }
}
