            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "question-bank",
          "style": {
            "navigationBarTitleText": "%pages.bank%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        }
      ]
    },
    {
      "root": "pages/login",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "%pages.login%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "onboarding",
          "style": {
            "navigationBarTitleText": "%pages.onboarding%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
        },
        {
          "path": "wechat-callback",
          "style": {
            "navigationBarTitleText": "%pages.wechat%",
            "navigationStyle": "custom",
            "navigationBarBackgroundColor": "#F5F7FA"
          }
