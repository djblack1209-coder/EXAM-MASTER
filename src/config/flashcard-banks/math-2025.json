      "subject": "数学",
      "year": "2025",
      "number": 1,
      "question": "设函数 f(x) = x²e^x，则 f'(0) = ______.",
      "options": [
        { "label": "A", "text": "0" },
        { "label": "B", "text": "1" },
        { "label": "C", "text": "2" },
        { "label": "D", "text": "e" }
      ],
      "answer": "A",
      "explanation": "f'(x) = 2xe^x + x²e^x = (2x + x²)e^x = x(2 + x)e^x。代入 x=0：f'(0) = 0·(2+0)·e^0 = 0。",
      "type": "single_choice",
      "source": "math-2025-manual",
      "tags": ["数学", "2025真题", "高等数学", "导数"]
    },
