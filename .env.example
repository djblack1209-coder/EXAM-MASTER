# 前端配置；仅在首次启动时复制为 .env.local，不覆盖已有配置。
# VITE_* 会进入客户端构建产物，只放公开配置。
# 数据库、JWT_SECRET、微信 AppSecret 和 AI keys 使用 laf-backend 的服务端配置。
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_API_FALLBACK_URL=
VITE_API_TIMEOUT=5000
VITE_CDN_URL=
VITE_ENABLE_SYNC=false
VITE_ENABLE_AI_DIAGNOSIS=false

# 开发模式可体验示例题；正式生产构建保持关闭。
VITE_ENABLE_MOCK=false
VITE_AUDIT_MODE=false
