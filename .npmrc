# 强制使用官方 npm registry，确保 CI/CD 环境兼容性
# npmmirror 不支持 npm audit API，会导致安全扫描失败
registry=https://registry.npmjs.org/

# DCloud 5.08 alpha packages still declare vite@5.2.8 exactly, while the
# audited build uses vite@6.4.2 to clear the production advisory. Builds are
# verified separately in the release gate.
legacy-peer-deps=true
